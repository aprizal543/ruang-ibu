  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "test:content": "node qa/customer-content-coverage.mjs && node qa/m2-content-regression.mjs && node --import tsx qa/editorial-source-refresh.mjs",
    "test:backend": "node --import tsx --test qa/backend/*.test.ts qa/backend/*.test.mjs",
    "test:auth:workerd": "node qa/workers/google-oidc-workerd.test.mjs",
    "admin:verify-google-sub": "node --import tsx scripts/admin/verify-google-sub.mjs",
    "admin:verify-production-owner-identity": "node --import tsx scripts/admin/verify-production-owner-identity.mjs",
    "admin:provision-production-owner": "node --import tsx scripts/admin/provision-production-owner.mjs",
    "test:browser:route-scroll": "node qa/public-regression.browser.mjs",
    "test:browser:route-scroll:legacy": "node qa/route-scroll.browser.mjs",
    "test:browser:m2": "node qa/public-regression.browser.mjs",
    "test:browser:m2:legacy": "node qa/m2-articles.browser.mjs",
    "test:browser:public-regression": "node qa/public-regression.browser.mjs",
    "test:browser:admin": "node qa/admin-dashboard.browser.mjs",
    "test:browser:m5a": "node qa/public-qna.browser.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/fraunces": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
